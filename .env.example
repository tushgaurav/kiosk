# Copy to `.env` (git-ignored). Used by `npm run dev`, `npm run preview` and `npm start`.

# Password for the leads admin at /admin. Defaults to "safesurge" if unset.
ADMIN_PASSWORD=change-me

# Port for the production server (`npm start`). Vite dev keeps its own port.
PORT=3000

# Where the SQLite database lives. Defaults to ./data/leads.db
# DB_PATH=./data/leads.db
